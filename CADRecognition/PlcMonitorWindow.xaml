<Window x:Class="CADRecognition.PlcMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLC寄存器监视"
        Height="420"
        Width="420"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">
    <Window.Resources>
        <Style x:Key="HighContrastDataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2C4666"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#6F88A6"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#2A2A2A" CornerRadius="4" Padding="8" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="图纸文件夹" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <DockPanel>
                    <Button Content="选择文件夹" DockPanel.Dock="Right" Margin="10,0,0,0" Click="ChooseFolder_Click" Width="80" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="FolderText" Foreground="#9CDCFE" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#252525" CornerRadius="4" Padding="8" Margin="0,0,0,10">
            <TextBlock Text="PLC寄存器" Foreground="#FFFFFF" FontWeight="SemiBold"/>
        </Border>

        <Border Grid.Row="2" Background="#252525" CornerRadius="4" Padding="8">
            <DataGrid x:Name="PlcRegisterGrid"
                      ItemsSource="{Binding PlcRegisters}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowBackground="#0F1722"
                      AlternatingRowBackground="#152131"
                      Background="#0B1220"
                      Foreground="#FFFFFF"
                      HorizontalGridLinesBrush="#2E415A"
                      VerticalGridLinesBrush="#2E415A"
                      BorderBrush="#4B5E78"
                      ColumnHeaderStyle="{StaticResource HighContrastDataGridHeaderStyle}"
                      CellEditEnding="PlcRegisterGrid_CellEditEnding">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Header="地址" Width="*"/>
                    <DataGridTextColumn Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Header="值" Width="2*"/>
                    <DataGridTextColumn Binding="{Binding Info, UpdateSourceTrigger=PropertyChanged}" Header="备注" Width="3*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>